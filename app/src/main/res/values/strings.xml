    <string name="sign_in_http_warning_title">Unencrypted connection</string>
    <string name="sign_in_http_warning_body">%1$s uses plain http. Your API token or password would travel unencrypted, so anyone on the network between this phone and the server could read it. Continue only if the network encrypts the traffic, as Tailscale does.</string>
