<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        No Android backup or device transfer (docs/PRD.md S8): Keystore keys
        stay on the phone, so a restored token could not be decrypted, and a
        restored queue could replay old changes.
    -->
    <application
        android:name=".TokklApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tokkl">
        <!--
            The app gives Android its night mode (settings/ApplicationNightMode.kt), which
            changes the activity's configuration. Compose redraws in place, so choosing a theme
            keeps the activity and the screen it shows instead of restarting it.

            adjustResize keeps the window in place when the keyboard opens and hands its
            height to Compose as the IME inset, which a form makes room for with imePadding.
            With no mode set, Android also panned the window, so the top of the screen left it.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
