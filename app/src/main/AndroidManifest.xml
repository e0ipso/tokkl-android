<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Lets the picker say when the phone is offline (docs/PRD.md P1), and lets the
        queue's background send wait for a network (O4). WorkManager's own manifest adds
        it too.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        WorkManager's manifest adds these two, and the background send (O4) needs both:
        WAKE_LOCK keeps the phone awake while the worker sends the queue, and
        RECEIVE_BOOT_COMPLETED lets WorkManager schedule the waiting send again after a
        reboot, so queued changes still go out. The same boot broadcast arms a running
        Pomodoro phase's exact alarm again (docs/PRD.md W7). Declared here only to say
        why they stay.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Only the Pomodoro phase-end alarm runs a foreground service: mediaPlayback keeps its
        bundled transition sound looping until Next phase or End session. API 34+ also requires
        the type-specific permission. VIBRATE is for its repeating alarm vibration. No runtime
        grant is needed for these permissions. WorkManager's SystemForegroundService stays
        removed below; the queue never calls setForeground. The running timer (N1) has no service.
        https://developer.android.com/develop/background-work/services/fgs/service-types#media
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        The running timer's notification (docs/PRD.md N1). Android 13 and later show it only once
        the user allows it; asking is TKA-0058's.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates (N2). This permission needs no runtime request. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!--
        A Pomodoro phase end is a user-facing alarm (docs/PRD.md W7), set with
        AlarmManager.setAlarmClock. API 31 and 32 grant SCHEDULE_EXACT_ALARM at install and the
        user can revoke it. API 33 and later grant USE_EXACT_ALARM at install, and the user
        cannot revoke it. Play's limit on that permission does not apply to an app shipped on
        F-Droid. SCHEDULE_EXACT_ALARM stops at API 32 so a later device is not asked for the
        revocable permission as well.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />

    <!-- Inspect only CSV receivers, to report when no app can handle explicit sharing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/csv" />
        </intent>
    </queries>

    <!--
        No Android backup or device transfer (docs/PRD.md S8): Keystore keys
        stay on the phone, so a restored token could not be decrypted, and a
        restored queue could replay old changes.
    -->
    <application
        android:name=".TokklApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tokkl">
        <!--
            The app gives Android its night mode (settings/ApplicationNightMode.kt), which
            changes the activity's configuration. Compose redraws in place, so choosing a theme
            keeps the activity and the screen it shows instead of restarting it.

            adjustResize keeps the window in place when the keyboard opens and hands its
            height to Compose as the IME inset, which a form makes room for with imePadding.
            With no mode set, Android also panned the window, so the top of the screen left it.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Only completed report CSV files, with per-URI temporary read grants. -->
        <provider
            android:name=".reports.ReportExportProvider"
            android:authorities="${applicationId}.report-exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- One mediaPlayback service for the Pomodoro alarm, never a WorkManager worker. -->
        <service
            android:name=".pomodoro.PomodoroRingingService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="mediaPlayback" />
        <receiver
            android:name=".pomodoro.PomodoroRingingActionReceiver"
            android:exported="false" />
        <!-- No worker runs in the foreground. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <receiver android:name=".reminder.ReminderActionReceiver" android:exported="false" />

        <!-- The running timer notification's Stop action. Only its own PendingIntent reaches it. -->
        <receiver
            android:name=".notification.StopTimerReceiver"
            android:exported="false" />
        <!--
            The Pomodoro phase's exact alarm. Not exported: only its own PendingIntent reaches it.
            It records that the phase reached its planned end and does not start the next phase.
        -->
        <receiver
            android:name=".pomodoro.PomodoroPhaseAlarmReceiver"
            android:exported="false" />
        <!--
            Arms that alarm again from the stored session after boot, an update, or a clock or
            timezone change, and when the exact-alarm permission is granted. Disabled until a
            session is running, so a reboot with no session does not start the app. The system
            sends these protected broadcasts, so the receiver is exported.
        -->
        <receiver
            android:name=".pomodoro.PomodoroAlarmRearmReceiver"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <!--
            The Quick Settings tile (docs/PRD.md N4). Only the system, which holds
            BIND_QUICK_SETTINGS_TILE, can bind it. No ACTIVE_TILE meta-data: the system binds it
            each time the panel shows it (see RunningTileService).
        -->
        <service
            android:name=".tile.RunningTileService"
            android:exported="true"
            android:icon="@drawable/ic_play"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!--
            A long press on the tile. SystemUI, another app, sends QS_TILE_PREFERENCES, so the
            activity is exported. It reads the queue and ignores the intent's extras. The
            translucent theme lets it draw a dialog over the shade and leave no recents entry.
        -->
        <activity
            android:name=".tile.TileControlsActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tokkl.TileControls">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!--
            The home screen widget (docs/PRD.md N3). Exported, since the launcher's widget service
            sends it the widget's updates. Its taps go to Glance's receiver, which is not exported.
        -->
        <receiver
            android:name=".widget.TokklWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tokkl_widget_info" />
        </receiver>
        <!-- A launcher shortcut queues its favorite and shows a toast without opening an app screen. -->
        <activity
            android:name=".shortcuts.StartFavoriteActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Tokkl.Shortcut" />
    </application>

</manifest>
