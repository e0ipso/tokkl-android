<?xml version="1.0" encoding="utf-8"?>
<!--
    The launcher icon: the clock O logo on plum. minSdk is 26, so this one adaptive icon covers
    every supported release and the app needs no legacy PNG mipmaps.

    Source: Tokkl's icon pack, ../tokkl/docs/brand/icon-pack (github.com/e0ipso/tokkl at
    1771f08). The foreground and monochrome layers in mipmap-mdpi to mipmap-xxxhdpi, 108 to
    432 px for the 108 dp layer, are byte-for-byte copies of the pack's android/res files.
    They already carry the adaptive icon padding: copy them as they are, with no inset, resize
    or icon generator step. The pack's README and checks.json describe how they are built.

    Left out of the pack: values/ic_launcher_background.xml, because res/values/colors.xml
    defines that colour; the mipmap-anydpi-v26 and -v33 definitions, which this file replaces;
    and the legacy mipmap-*/ic_launcher.png files, which no release from API 26 on loads.

    The monochrome layer is for themed icons, which launchers show from Android 13 when the
    user turns them on.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
