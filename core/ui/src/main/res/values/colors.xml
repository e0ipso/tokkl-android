<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window behind Compose, so launch shows the theme's background with no flash.
        The light value of the bg token in styles.css, the same value as
        TokklLightColorScheme.background in ui/theme/Color.kt.
    -->
    <color name="window_background">#FFFDF7</color>

    <!--
        The 1dp outline around the wordmark, the wordmark-halo token of styles.css: transparent
        in light, where the splash icon draws none. The same values as wordmarkHalo in
        ui/theme/Color.kt.
    -->
    <color name="wordmark_halo">#00000000</color>

    <!--
        The launcher icon's background layer, in light and dark alike: the wordmark's dark plum
        from Tokkl's icon pack. It is not a palette token.
    -->
    <color name="ic_launcher_background">#291329</color>
</resources>
