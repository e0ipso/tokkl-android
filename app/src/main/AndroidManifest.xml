<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Lets the picker say when the phone is offline (docs/PRD.md P1), and lets the
        queue's background send wait for a network (O4). WorkManager's own manifest adds
        it too.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        WorkManager's manifest adds these two, and the background send (O4) needs both:
        WAKE_LOCK keeps the phone awake while the worker sends the queue, and
        RECEIVE_BOOT_COMPLETED lets WorkManager schedule the waiting send again after a
        reboot, so queued changes still go out. The same boot broadcast arms a running
        Pomodoro phase's exact alarm again (docs/PRD.md W7). Declared here only to say
        why they stay.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        Two foreground services. The Pomodoro phase-end alarm is mediaPlayback: it keeps its
        bundled transition sound looping until Next phase or End session. The timer sync service
        is specialUse: it holds the Tokkl server's timer event stream open, so sessions and pauses
        from other devices reach the phone in the background. API 34+ also requires each
        type-specific permission. VIBRATE is for the alarm's repeating vibration. No runtime grant
        is needed for these permissions. WorkManager's SystemForegroundService stays removed
        below; the queue never calls setForeground. The running timer (N1) has no service.
        https://developer.android.com/develop/background-work/services/fgs/service-types#media
        https://developer.android.com/develop/background-work/services/fgs/service-types#special-use
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!--
        Only the high-importance Pomodoro phase-end alarm opens over the lock screen.
        API 34+ special app access can be denied, including by third-party installers;
        the Pomodoro page checks canUseFullScreenIntent and links the per-app setting.
        https://developer.android.com/about/versions/14/behavior-changes-14#secure-fsi
        https://source.android.com/docs/core/permissions/fsi-limits
    -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!--
        The running timer's notification (docs/PRD.md N1). Android 13 and later show it only once
        the user allows it; asking is TKA-0058's.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates (N2). This permission needs no runtime request. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!--
        A Pomodoro phase end is a user-facing alarm (docs/PRD.md W7), set with
        AlarmManager.setAlarmClock. API 31 and 32 grant SCHEDULE_EXACT_ALARM at install and the
        user can revoke it. API 33 and later grant USE_EXACT_ALARM at install, and the user
        cannot revoke it. Play's limit on that permission does not apply to an app shipped on
        F-Droid. SCHEDULE_EXACT_ALARM stops at API 32 so a later device is not asked for the
        revocable permission as well.
    -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />

    <!-- Inspect only CSV receivers, to report when no app can handle explicit sharing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/csv" />
        </intent>
    </queries>

    <!--
        No Android backup or device transfer (docs/PRD.md S8): Keystore keys
        stay on the phone, so a restored token could not be decrypted, and a
        restored queue could replay old changes.
    -->
    <application
        android:name=".TokklApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tokkl">
        <!--
            The app gives Android its night mode (settings/ApplicationNightMode.kt), which
            changes the activity's configuration. Compose redraws in place, so choosing a theme
            keeps the activity and the screen it shows instead of restarting it.

            adjustResize keeps the window in place when the keyboard opens and hands its
            height to Compose as the IME inset, which a form makes room for with imePadding.
            With no mode set, Android also panned the window, so the top of the screen left it.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- No worker runs in the foreground. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!--
            TokklApplication starts WorkManager with Koin's worker factory, which gives the workers
            their dependencies, so WorkManager's own startup initializer stays out.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
