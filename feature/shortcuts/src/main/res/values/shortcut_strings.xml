<?xml version="1.0" encoding="utf-8"?>
<!--
    Launcher shortcuts for timer templates (docs/PRD.md N6). Their labels are the templates'
    names; these are the toasts a tap on one shows.
-->
<resources>
    <!-- A tap on a template's shortcut started its timer: Started Write the report -->
    <string name="shortcut_started">Started %1$s</string>
    <!-- A shortcut the user pinned to the home screen, for a template that is no longer there. -->
    <string name="shortcut_gone">That timer template is no longer in Tokkl</string>
    <string name="shortcut_failed">Tokkl could not start the timer</string>
</resources>
