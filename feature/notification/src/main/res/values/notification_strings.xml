<!-- The running timer's notification (docs/PRD.md N1). -->
<resources>
    <!-- The notification channel, as the app's notification settings list it. -->
    <string name="notification_channel_running">Running timer</string>
    <string name="notification_channel_running_description">Shows the running timer with its elapsed time and a button to stop it.</string>
    <!-- The title of a running entry without a description. -->
    <string name="notification_no_description">No description</string>
