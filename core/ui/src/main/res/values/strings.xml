<?xml version="1.0" encoding="utf-8"?>
<!-- The app's name, the top bar's back button, and the dates and durations that ui/DateWords.kt writes and speaks. -->
<resources>
    <string name="app_name">Tokkl</string>
    <string name="back">Back</string>
    <!-- 13 Oct: the day of the month and the month's short name. -->
    <string name="reports_date">%1$d %2$s</string>
    <!-- 13 Oct 2026 -->
    <string name="reports_date_year">%1$d %2$s %3$d</string>
    <!-- Mon 13 Oct: a weekday's short name and a date. -->
    <string name="reports_bucket_day">%1$s %2$s</string>
    <!-- Monday first, as java.time numbers the days. -->
    <string-array name="reports_weekdays_short">
        <item>Mon</item>
        <item>Tue</item>
        <item>Wed</item>
        <item>Thu</item>
        <item>Fri</item>
        <item>Sat</item>
        <item>Sun</item>
    </string-array>
    <string-array name="reports_months_short">
        <item>Jan</item>
        <item>Feb</item>
        <item>Mar</item>
        <item>Apr</item>
        <item>May</item>
        <item>Jun</item>
        <item>Jul</item>
        <item>Aug</item>
        <item>Sep</item>
        <item>Oct</item>
        <item>Nov</item>
        <item>Dec</item>
    </string-array>
    <string name="reports_spoken_no_time">no time</string>
    <plurals name="reports_spoken_hours">
        <item quantity="one">%d hour</item>
        <item quantity="other">%d hours</item>
    </plurals>
    <plurals name="reports_spoken_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="reports_spoken_seconds">
        <item quantity="one">%d second</item>
        <item quantity="other">%d seconds</item>
    </plurals>
</resources>
