<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The window behind Compose, so launch shows the theme's background with no flash.
        The light bg token at styles.css:161, the same value as TokklLightColorScheme.background
        in ui/theme/Color.kt.
    -->
    <color name="window_background">#F4E7CF</color>

    <!--
        The launcher icon's background layer, in light and dark alike: the wordmark's dark plum
        from Tokkl's icon pack, ../tokkl/docs/brand/icon-pack (android/res/values and
        checks.json). It is not a palette token.
    -->
    <color name="ic_launcher_background">#291329</color>
</resources>
