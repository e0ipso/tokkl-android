<?xml version="1.0" encoding="utf-8"?>
<!--
    The brand images for mdpi screens, at 1x. With no density qualifier this set counts as
    mdpi, so ldpi screens get it too. raw/brand_images_source.txt says why they are aliases.
-->
<resources>
    <drawable name="tokkl_icon_sm">@drawable/tokkl_icon_24px</drawable>
    <drawable name="tokkl_icon_md">@drawable/tokkl_icon_30px</drawable>
    <drawable name="tokkl_icon_lg">@drawable/tokkl_icon_48px</drawable>
    <drawable name="tokkl_wordmark_sm">@drawable/tokkl_wordmark_84px</drawable>
    <drawable name="tokkl_wordmark_md">@drawable/tokkl_wordmark_130px</drawable>
    <drawable name="tokkl_wordmark_lg">@drawable/tokkl_wordmark_260px</drawable>
</resources>
