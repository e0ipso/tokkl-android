<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Only completed report CSV files, with per-URI temporary read grants. -->
        <provider
            android:name="com.github.e0ipso.tokkl.reports.ReportExportProvider"
            android:authorities="${applicationId}.report-exports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
