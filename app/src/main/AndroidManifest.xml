<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Lets the picker say when the phone is offline (docs/PRD.md P1), and lets the
        queue's background send wait for a network (O4). WorkManager's own manifest adds
        it too.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        WorkManager's manifest adds these two, and the background send (O4) needs both:
        WAKE_LOCK keeps the phone awake while the worker sends the queue, and
        RECEIVE_BOOT_COMPLETED lets WorkManager schedule the waiting send again after a
        reboot, so queued changes still go out. Declared here only to say why they stay.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
        WorkManager's manifest also adds FOREGROUND_SERVICE and its SystemForegroundService,
        which serve only workers that call setForeground. The queue's worker never does, and
        the running timer's notification runs no foreground service (N1), so both go.
    -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <!--
        The running timer's notification (docs/PRD.md N1). Android 13 and later show it only once
        the user allows it; asking is TKA-0058's.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates (N2). This permission needs no runtime request. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!--
        No Android backup or device transfer (docs/PRD.md S8): Keystore keys
        stay on the phone, so a restored token could not be decrypted, and a
        restored queue could replay old changes.
    -->
    <application
        android:name=".TokklApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tokkl">
        <!--
            The app gives Android its night mode (settings/ApplicationNightMode.kt), which
            changes the activity's configuration. Compose redraws in place, so choosing a theme
            keeps the activity and the screen it shows instead of restarting it.

            adjustResize keeps the window in place when the keyboard opens and hands its
            height to Compose as the IME inset, which a form makes room for with imePadding.
            With no mode set, Android also panned the window, so the top of the screen left it.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- See FOREGROUND_SERVICE above: no worker runs in the foreground. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            tools:node="remove" />
        <!-- The running timer notification's Stop action. Only its own PendingIntent reaches it. -->
        <receiver
            android:name=".notification.StopTimerReceiver"
            android:exported="false" />
        <!--
            The Quick Settings tile (docs/PRD.md N4). Only the system, which holds
            BIND_QUICK_SETTINGS_TILE, can bind it. No ACTIVE_TILE meta-data: the system binds it
            each time the panel shows it (see RunningTileService).
        -->
        <service
            android:name=".tile.RunningTileService"
            android:exported="true"
            android:icon="@drawable/ic_play"
            android:label="@string/tile_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>
