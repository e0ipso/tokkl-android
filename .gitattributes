# Line endings for the Gradle wrapper, as in Gradle's init template. A gradlew
# with CRLF does not run on Linux, whatever core.autocrlf says.
/gradlew        text eol=lf
*.bat           text eol=crlf
*.jar           binary

# Preserve raw test output in plan evidence, including archived plans.
.ai/strikethroo/**/evidence/**/*.log -whitespace
.ai/strikethroo/**/evidence/**/logcat-*.txt -whitespace
