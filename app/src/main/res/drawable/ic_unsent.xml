<?xml version="1.0" encoding="utf-8"?>
<!--
    An arrow up to a line, the mark of an entry that waits to go up to the server, on a calendar
    block too short for the words Not sent. It is Tokkl's "upload" icon from
    packages/web/src/components/Icon.tsx (github.com/e0ipso/tokkl, MIT), drawn the way that
    component draws it: a 2-unit stroke with round caps and joins, and no fill.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M12,21V9M7,14l5,-5 5,5M4,3h16" />
</vector>
