<!--
    The favorites' launcher shortcuts (docs/PRD.md N6). Their labels are the favorites' names, as
    the Timer page shows them; these are the toasts a tap on one shows.
-->
<resources>
    <!-- A tap on a favorite's shortcut started its timer: Started Write the report -->
    <string name="shortcut_started">Started %1$s</string>
    <!-- A shortcut the user pinned to the home screen, for a favorite that is no longer there. -->
    <string name="shortcut_gone">That favorite is no longer in Tokkl</string>
    <string name="shortcut_failed">Tokkl could not start the timer</string>
</resources>
